"],\"text\":\"Activity reports\"},{\"_key\":\"c90b00cf96801\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\nCalls. Emails. Meetings booked. Accounts worked. The sales report template gives you an overview of crucial activity metrics for B2B sales teams.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"370eea1b0096\",\"_type\":\"block\",\"children\":[{\"_key\":\"370eea1b00960\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Pipeline reports\"},{\"_key\":\"370eea1b00961\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\nGet a weekly report on pipeline coverage and calculate needed pipeline to close the gap between your bookings and your target.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"13e4c3c41940\",\"_type\":\"block\",\"children\":[{\"_key\":\"13e4c3c419400\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Leaderboards\"},{\"_key\":\"13e4c3c419401\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\nAutomatically generate a leaderboard for activity and pipeline metrics so you know which reps to focus on.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6be190a8b397\",\"_type\":\"block\",\"children\":[{\"_key\":\"6be190a8b3970\",\"_type\":\"span\",\"marks\":[],\"text\":\"FAQ\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"fc4f0d10e64a\",\"_type\":\"block\",\"children\":[{\"_key\":\"fc4f0d10e64a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Who is the sales report excel template for?\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a45199ddd0e1\",\"_type\":\"block\",\"children\":[{\"_key\":\"a45199ddd0e10\",\"_type\":\"span\",\"marks\":[],\"text\":\"If you manage a team of B2B sales reps, this is for you! The report gives you insights from two perspectives: Activity Metrics and Pipeline. It will help you evaluate reps, forecast, and even identify pipeline risk, all based on reality, not opinion.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"261f6f157fa1\",\"_type\":\"block\",\"children\":[{\"_key\":\"261f6f157fa10\",\"_type\":\"span\",\"marks\":[],\"text\":\"What format does the report come in?\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"cc8850c21527\",\"_type\":\"block\",\"children\":[{\"_key\":\"cc8850c215270\",\"_type\":\"span\",\"marks\":[],\"text\":\"The sales report template is available as an excel file and as a Google Sheet. Regardless of which format you use, the value of the insights are exactly the same. Both versions include two important tabs: Activity Metrics and Pipeline.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a4399ac5dc5e\",\"_type\":\"block\",\"children\":[{\"_key\":\"a4399ac5dc5e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Do I need to know Microsoft Excel to use this sales report template?\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a0a364ac9ae2\",\"_type\":\"block\",\"children\":[{\"_key\":\"a0a364ac9ae20\",\"_type\":\"span\",\"marks\":[],\"text\":\"No.: This template comes with pre-built formulas so you only need to update the data in the excel spreadsheet and let the template do the rest. No need to be a master in Excel or Google Sheets—this template is built to be easy to use.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"572aff4e0ede\",\"_type\":\"block\",\"children\":[{\"_key\":\"572aff4e0ede0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Do you have any other tips or sales reporting best practices?\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"01102f7fed91\",\"_type\":\"block\",\"children\":[{\"_key\":\"01102f7fed910\",\"_type\":\"span\",\"marks\":[],\"text\":\"The key to effective sales reporting is knowing which insights matter. We’re talking pipeline risk, activities of top performers, and which activities are most likely to lead to success. Easier said than done, which is why so many teams turn to sales reporting software to extract this intelligence.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":