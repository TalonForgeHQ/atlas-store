"linkType\":\"external\",\"openInNewTab\":false},\"mode\":\"filled\",\"tone\":\"primary\"}]}],\"eyebrow\":{\"_type\":\"eyebrow\",\"elementType\":\"h6\",\"eyebrow\":\"Frequently asked questions\"},\"heading\":{\"_type\":\"heading\",\"elementType\":\"h2\",\"fontFamily\":\"inter\",\"heading\":[{\"_key\":\"12a56a065bbe\",\"_type\":\"block\",\"children\":[{\"_key\":\"aae69bd99269\",\"_type\":\"span\",\"marks\":[],\"text\":\"FAQ\"}],\"markDefs\":[],\"style\":\"normal\"}],\"headingSize\":\"2xl\"},\"items\":[{\"_key\":\"e2ac5adeea9b\",\"_type\":\"accordionItem\",\"content\":[{\"_key\":\"c586acdf2e8e\",\"_type\":\"block\",\"children\":[{\"_key\":\"597dcee349e4\",\"_type\":\"span\",\"marks\":[],\"style\":null,\"text\":\"We take your data protection seriously. Gong implements enterprise-grade security measures, including data encryption in transit and at rest, multi-factor authentication, role-based access controls, and segregated customer data environments hosted on AWS. All access to customer data is logged and auditable. You can find more information about our security features on our \"},{\"_key\":\"7284ccdb1e94\",\"_type\":\"span\",\"marks\":[\"9d568661d037\"],\"style\":null,\"text\":\"help center\"},{\"_key\":\"befcfcdd7f20\",\"_type\":\"span\",\"marks\":[],\"style\":null,\"text\":\".\"}],\"level\":null,\"listItem\":null,\"markDefs\":[{\"_key\":\"9d568661d037\",\"_type\":\"link\",\"blank\":null,\"href\":\"https://help.gong.io/docs/summary-of-security-features\"}],\"style\":\"normal\"}],\"label\":\"How does Gong protect my data?\"},{\"_key\":\"b86b805ed167\",\"_type\":\"accordionItem\",\"content\":[{\"_key\":\"eeddc89e5d27\",\"_type\":\"block\",\"children\":[{\"_key\":\"9897c69e4719\",\"_type\":\"span\",\"marks\":[],\"style\":null,\"text\":\"Gong AI is developed in-house. It’s designed to be transparent, auditable, and is guided by a dedicated governance and oversight team. We show how AI outcomes are created, give you visibility into model training, and include human validation where it matters. We’re also ISO 42001 certified — the new gold standard for responsible AI.\"}],\"level\":null,\"listItem\":null,\"markDefs\":[],\"style\":\"normal\"}],\"label\":\"How does Gong ensure AI transparency and governance?\"},{\"_key\":\"4f3ded5c0903\",\"_type\":\"accordionItem\",\"content\":[{\"_key\":\"817fe8dfbe25\",\"_type\":\"block\",\"children\":[{\"_key\":\"7dc98043ad15\",\"_type\":\"span\",\"marks\":[],\"style\":null,\"text\":\"No. Your data is never used to train generative AI models, and it’s never shared with or exposed to the public domain. Gong uses a secure, in-house AI framework that keeps your data fully isolated. We don’t co-mingle customer data, and any AI outputs are generated strictly within your own data environment, so you always stay in control of your data.\"}],\"level\":null,\"listItem\":null,\"markDefs\":[],\"style\":\"normal\"}],\"label\":\"Is customer data used to train generative AI?\"},{\"_key\":\"8127ebd64976\",\"_type\":\"accordionItem\",\"content\":[{\"_key\":\"c51f42da1acf\",\"_type\":\"block\",\"children\":[{\"_key\":\"80b4f980fc5b\",\"_type\":\"span\",\"marks\":[],\"style\":null,\"text\":\"Yes. Gong offers granular configurability for data collection (via redaction, deny lists, and filtering rules), consent management (with support for 70+ languages), and data retention and deletion policies. Administrators can define business logic for recordings and email ingestion and redact sensitive data automatically.\"}],\"level\":null,\"listItem\":null,\"markDefs\":[],\"style\":\"normal\"}],\"label\":\"Can I control what data Gong collects and processes?\"},{\"_key\":\"987012114865\",\"_type\":\"accordionItem\",\"content\":[{\"_key\":\"3d55ed954207\",\"_type\":\"block\",\"children\":[{\"_key\":\"02636ac7ff8d\",\"_type\":\"span\",\"marks\":[],\"style\":null,\"text\":\"Gong is built to help you meet privacy requirements like GDPR and CCPA by implementing measures to support compliance — including tools for recording consent, data export and deletion, and a published list of our subprocessors and data handling practices. Gong is also certified under the EU-U.S., Swiss-U.S., and UK-U.S. Data Privacy Frameworks as well as ISO 27701 (Privacy Information Management System) and ISO 27018 (PII protection for cloud providers).\"}],\"level\":null,\"listItem\":null,\"markDefs\":[],\"style\":\"normal\"}],\"label\":\"What about regulations like GDPR and CCPA?\"},{\"_key\":\"c3f4758eb782\",\"_type\":\"accordionItem\",\"content\":[{\"_key\":\"ca53f6a1b3ba\",\"_type\":\"block\",\"children\":[{\"_key\":\"0b92b1038dc0\",\"_type\":\"span\",\"marks\":[],\"style\":null,\"text\":\"You can find a full list of sub-processors \"},{\"_key\":\"95335d3934a0\",\"_type\":\"span\",\"marks\":[\"72de7f1f5213\"],\"style\":null,\"text\":\"here on our website\"},{\"_key\":\"94119956a9bb\",\"_type\":\"span\",\"marks\":[],\"style\":null,\"text\":\".\"}],\"level\":null,\"listItem\":null,\"markDefs\":[{\"_key\":\"72de7f1f5213\",\"_type\":\"link\",\"blank\":null,\"href\":\"https://www.gong.io/sub-processors/\"}],\"style\":\"normal\"}],\"label\":\"What parties process my data in addition to Gong?\"},{\"_key\":\"42e7062b8e70\",\"_type\":\"accordionItem\",\"content\":[{\"_key\":\"225aa35414b6\",\"_type\":\"block\",\"children\":[{\"_key\":\"524bb68afd2f\",\"_type\":\"span\",\"marks\":[],\"style\":null,\"text\":\"By default, Gong retains customer data for up to three years or the duration of your contract — whichever is shorter. You can request a custom retention period, and all data is permanently deleted 30 days after contract termination.\"}],\"level\":null,\"listItem\":null,\"markDefs\":[],\"style\":\"normal\"}],\"label\":\"What is Gong’s data retention policy?\"},{\"_key\":\"e2ba49988cc4\",\"_type\":\"accordionItem\",\"content\":[{\"_key\":\"54cc1a626ac7\",\"_type\":\"block\",\"children\":[{\"_key\":\"b78cd27a5c7b\",\"_type\":\"span\",\"marks\":[],\"style\":null,\"text\":\"While Gong is not a covered entity, we map HIPAA controls in our SOC 2 Type II audit.\"}],\"level\":null,\"listItem\":null,\"markDefs\":[],\"style\":\"normal\"}],\"label\":\"How does Gong support HIPAA compliance?\"},{\"_key\":\"b6b8a726b130\",\"_type\":\"accordionItem\",\"content\":[{\"_key\":\"3f6900228c02\",\"_type\":\"block\",\"children\":[{\"_key\":\"8efb5ed818ca\",\"_type\":\"span\",\"marks\":[],\"style\":null,\"text\":\"Yes — Gong delivers 99.5% uptime to customers around the world and offers full transparency through our \"},{\"_key\":\"d1285a277780\",\"_type\":\"span\",\"marks\":[\"8db16b88b1bc\"],\"style\":null,\"text\":\"Status Page\"},{\"_key\":\"a53b4def8324\",\"_type\":\"span\",\"marks\":[],\"style\":null,\"text\":\". You can monitor system health, subscribe to updates, and get real-time visibility into any scheduled maintenance or service incidents.\"}],\"level\":null,\"listItem\":null,\"markDefs\":[{\"_key\":\"8db16b88b1bc\",\"_type\":\"link\",\"blank\":null,\"href\":\"https://status.gong.io/\"}],\"style\":\"normal\"}],\"label\":\"Does Gong provide real-time system status updates?\"},{\"_key\":\"05d233d3266d\",\"_type\":\"accordionItem\",\"content\":[{\"_key\":\"5b5bb86bbf71\",\"_type\":\"block\",\"children\":[{\"_key\":\"33f9376d6c93\",\"_type\":\"span\",\"marks\":[],\"style\":null,\"text\":\"Gong provides full transparency through its publicly available \"},{\"_key\":\"c766ca59b4a0\",\"_type\":\"span\",\"marks\":[\"cfe3e888bea9\"],\"style\":null,\"text\":\"Trust Center\"},{\"_key\":\"7ca13dd59c4a\",\"_type\":\"span\",\"marks\":[],\"style\":null,\"text\":\". It’s your go-to for security documentation, certifications, policies, and more FAQ. If you're running a review or security assessment, you'll find everything you need there.\"}],\"level\":null,\"listItem\":null,\"markDefs\":[{\"_key\":\"cfe3e888bea9\",\"_type\":\"link\",\"blank\":null,\"href\":\"https://trust.gong.io/\"}],\"style\":\"normal\"}],\"label\":\"Where can I find detailed information about Gong’s security practices?\"}],\"layout\":\"s